{
  "manifest_version": 3,
  "name": "No Dupe Tabs",
  "short_name": "No Dupe Tabs",
  "version": "0.1.0",
  "description": "Prevent duplicate tabs: switch to the tab you already have open, find and close existing duplicates, and search your tabs.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "No Dupe Tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "contextMenus", "notifications"],
  "omnibox": { "keyword": "dt" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" }
    },
    "close-duplicates": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Close all duplicate tabs"
    },
    "toggle-pause": {
      "description": "Pause or resume duplicate prevention"
    },
    "exempt-site": {
      "description": "Never dedupe the current site"
    }
  }
}
